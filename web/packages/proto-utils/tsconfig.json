{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM"],
        "paths": {
            "@servora/proto-utils/crud": ["./src/crud/index.ts"],
            "@servora/proto-utils/transport": ["./src/transport.ts"]
        }
    },
    "include": ["src/**/*.ts"]
}
